# Automation Generator Configuration Template
version: "1.0"

# Required: LLM Configuration
llm:
  provider: "gemini"  # Options: gemini, openai, claude
  api_key: "${GEMINI_API_KEY}"  # Environment variable or direct key
  model: "gemini-1.5-flash"
  backup_providers: []  # Optional fallback providers
    # - provider: "openai"
    #   api_key: "${OPENAI_API_KEY}"
    #   model: "gpt-4"

# Required: Database Configuration  
database:
  mongodb_uri: "${MONGODB_URI}"
  database_name: "automation_generator"
  collections:
    solutions: "solutions"
    ratings: "ratings"
    users: "users"
    analytics: "analytics"

# Optional: Application Settings
app:
  host: "localhost"
  port: 8501
  theme: "light"  # Options: light, dark, auto
  debug: false
  log_level: "INFO"  # Options: DEBUG, INFO, WARNING, ERROR
  max_file_size_mb: 20
  session_timeout_hours: 24

# Optional: Feature Flags
features:
  enable_community: true
  enable_ratings: true
  enable_analytics: true
  enable_multi_language: true
  enable_visualizations: true
  enable_api: false  # Future: REST API

# Optional: Security Settings
security:
  require_auth: false  # Future: Authentication
  allowed_domains: []  # Future: Domain restrictions
  rate_limiting: true
  max_requests_per_hour: 100

# Optional: Advanced Settings
advanced:
  cache_enabled: true
  cache_ttl_hours: 24
  background_tasks: true
  telemetry_enabled: true  # Anonymous usage statistics