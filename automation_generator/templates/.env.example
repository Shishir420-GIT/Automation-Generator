# Automation Generator Environment Variables
# Copy this file to .env and update with your actual values

# Required: LLM API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here  # Optional: For OpenAI support
# CLAUDE_API_KEY=your_claude_api_key_here  # Optional: For Claude support

# Required: Database Configuration
MONGODB_URI=mongodb://localhost:27017/automation_generator
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/automation_generator  # For MongoDB Atlas

# Optional: Application Configuration
AUTOMATION_GENERATOR_CONFIG_DIR=/home/user/.automation-generator
AUTOMATION_GENERATOR_HOST=localhost
AUTOMATION_GENERATOR_PORT=8501
AUTOMATION_GENERATOR_DEBUG=false
AUTOMATION_GENERATOR_LOG_LEVEL=INFO

# Optional: Security (for future use)
ADMIN_PASSWORD=secure_admin_password_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Optional: MongoDB Root Password (for Docker deployments)
MONGO_ROOT_PASSWORD=secure_mongo_password
MONGO_EXPRESS_PASSWORD=secure_express_password

# Optional: Feature Flags
ENABLE_TELEMETRY=true
ENABLE_ANALYTICS=true
ENABLE_VECTOR_SEARCH=true

# Optional: Advanced Settings
CACHE_TTL_HOURS=24
MAX_REQUESTS_PER_HOUR=100
SESSION_TIMEOUT_HOURS=24